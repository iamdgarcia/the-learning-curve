# ElevenLabs — STT + TTS
# Get your key at https://try.elevenlabs.io/5rwirobe89kq
ELEVENLABS_API_KEY=

# Voice ID — browse voices at elevenlabs.io/voice-library
# Default if unset: uses Aria (eleven_v4_turbo, works well in Spanish)
ELEVENLABS_VOICE_ID=

# LLM via Novita AI (OpenAI-compatible endpoint)
# Get your key at https://novita.ai
NOVITA_API_KEY=

# Model — any OpenAI-compatible model Novita serves
# Default: deepseek/deepseek-v4.1-flash-1017
NOVITA_MODEL=deepseek/deepseek-v4.1-flash-1017
