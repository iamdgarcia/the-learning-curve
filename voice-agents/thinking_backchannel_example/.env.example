# ElevenLabs — https://elevenlabs.io (used for both STT and TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID to use for TTS filler clips and responses.
# Default "JBFqnCBsd6RMkjVDRZzb" = George (works on free tier).
# Find yours at: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# NovitaAI — https://novita.ai/?ref=mzblm2z&utm_source=affiliate
NOVITA_API_KEY=your_novita_api_key_here
# Model to use. Good choices:
#   deepseek/deepseek-v3-0324   (fast, very capable)
#   meta-llama/llama-3.3-70b-instruct
#   qwen/qwen2.5-72b-instruct
NOVITA_MODEL=deepseek/deepseek-v3-0324
