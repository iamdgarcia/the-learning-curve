# ElevenLabs — https://elevenlabs.io (STT + TTS)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID for TTS. Default = George (free tier).
# Find yours at: https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Local LLM model (HuggingFace model ID, downloaded on first run)
# Options by size / quality trade-off:
#   Qwen/Qwen2.5-0.5B-Instruct   ~1 GB  — CPU-friendly, fast, limited reasoning
#   Qwen/Qwen2.5-1.5B-Instruct   ~3 GB  — good balance
#   Qwen/Qwen2.5-7B-Instruct     ~15 GB — best quality, needs GPU
SPEC_MODEL=Qwen/Qwen2.5-0.5B-Instruct
