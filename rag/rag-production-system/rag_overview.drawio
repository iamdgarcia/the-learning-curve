                <mxCell id="80" value="&lt;b&gt;Conceptos clave:&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="665" width="200" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="81" value="&lt;b&gt;¿Por qué RAG?&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Los LLMs tienen fecha de corte de conocimiento&lt;br&gt;• RAG permite acceder a información actualizada&lt;br&gt;• Reduce alucinaciones al anclar respuestas en documentos reales&lt;br&gt;• Más económico que reentrenar el modelo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="40" y="693" width="320" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="82" value="&lt;b&gt;Embedding&lt;/b&gt;&lt;br&gt;&lt;br&gt;Representación numérica del significado semántico de un texto. Textos con significado similar tienen vectores cercanos en el espacio de alta dimensión (ej: 1536 dimensiones en text-embedding-ada-002)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="377" y="693" width="310" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="83" value="&lt;b&gt;Similitud Coseno&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mide el ángulo entre dos vectores (0 = muy diferentes, 1 = idénticos). Permite encontrar los fragmentos más relevantes para cada consulta sin importar la longitud del texto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="704" y="693" width="310" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="84" value="&lt;b&gt;Prompt con Contexto&lt;/b&gt;&lt;br&gt;&lt;br&gt;El LLM recibe: [contexto recuperado] + [pregunta del usuario]. Instrucción típica: &lt;i&gt;&quot;Responde SÓLO basándote en el contexto. Si no lo sabes, dilo.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bdbdbd;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="1031" y="693" width="320" height="115" as="geometry"/>
                </mxCell>
