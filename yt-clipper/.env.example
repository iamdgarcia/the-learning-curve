# ── LLM (OpenAI-compatible) ────────────────────────────────────────────────────
# Default: Novita.ai with DeepSeek v3 (cheap, multilingual, no json_object needed)
NOVITA_API_KEY=sk_your_novita_key_here
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_MODEL=deepseek/deepseek_v3

# Alternative: use OpenAI directly
# NOVITA_API_KEY=sk-your-openai-key
# NOVITA_BASE_URL=https://api.openai.com/v1
# NOVITA_MODEL=gpt-4o-mini

# ── YouTube OAuth ────────────────────────────────────────────────────────────
# Download from Google Cloud Console → APIs → Credentials → OAuth 2.0 Client ID
# Enable: YouTube Data API v3 + YouTube Analytics API
YOUTUBE_CLIENT_SECRETS_FILE=config/client_secrets.json
YOUTUBE_TOKEN_FILE=config/token.json

# ── Pipeline defaults ─────────────────────────────────────────────────────────
DEFAULT_PRIVACY_STATUS=unlisted
MAX_CLIPS_PER_VIDEO=5
OUTPUT_DIR=temp

# ── B-roll (optional) ─────────────────────────────────────────────────────────
# Free tier: 200 requests/hour — https://www.pexels.com/api/
PEXELS_API_KEY=
