                <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=50;" value="&lt;b&gt;Decisión&lt;/b&gt;&lt;br&gt;&lt;br&gt;flap: 0.993&lt;br&gt;no_flap: 0.007&lt;br&gt;&lt;br&gt;→ action = 1 (FLAP)" vertex="1">
