                <mxCell id="50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=5;align=left;" value="&lt;b&gt;main.py — Game Loop&lt;/b&gt;&lt;hr/&gt;obs = env.reset()&lt;br&gt;while True:&lt;br&gt;&amp;nbsp;&amp;nbsp;state = format_state(obs)&lt;br&gt;&amp;nbsp;&amp;nbsp;probs = engine.predict(state)&lt;br&gt;&amp;nbsp;&amp;nbsp;action = argmax(probs)&lt;br&gt;&amp;nbsp;&amp;nbsp;obs, rew, done = env.step(action)" vertex="1">
